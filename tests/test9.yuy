routine main() is
    var matrix : array [2] array [3] integer

    matrix[1][1] := 1
    matrix[1][2] := 2
    matrix[1][3] := 3

    matrix[2][1] := 4
    matrix[2][2] := 5
    matrix[2][3] := 6

    print matrix[2][1]
    print matrix[2][2]
    print matrix[2][3]
    print matrix[1][1]
    print matrix[1][2]
    print matrix[1][3]
end