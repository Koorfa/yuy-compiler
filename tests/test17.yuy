type Point is record
    var x: integer
    var y: integer
end

routine create_point(px : integer, py : integer) : Point is
    var p : Point
    p.x := px
    p.y := py
    => p
end

routine move_point_by(p: Point, dx : integer, dy : integer): Point is
    p.x := p.x + dx
    p.y := p.y + dy
    => p
end

routine main() is
    var p: Point
    var moved: Point

    p := create_point(10, 20)
    print p.x
    print p.y

    moved := move_point_by(p, 5, -3)
    print moved.x
    print moved.y
end